NODE_ENV=development
PUBLIC_ORIGIN=http://localhost:8080
BASE_PATH=/feishu
PORT=8080
FEISHU_APP_ID=cli_replace_me
FEISHU_APP_SECRET=replace_me
FEISHU_SCOPES=offline_access
# Optional: limit deployment to specific users of this Feishu application.
FEISHU_ALLOWED_USERS=
OAUTH_REDIRECT_URIS=https://chatgpt.com/connector_platform_oauth_redirect
# Memory is only accepted outside production.
STATE_STORE=memory
# Production:
# NODE_ENV=production
# PUBLIC_ORIGIN=https://mcp.example.com
# OSS_BUCKET=your-private-state-bucket
# OSS_REGION=oss-your-region
# OSS_PREFIX=feishu/
# OSS_INTERNAL=true
# STATE_ENCRYPTION_KEY=<32 random bytes encoded as base64>
# FC injects ALIBABA_CLOUD_ACCESS_KEY_ID / SECRET / SECURITY_TOKEN from its role.
