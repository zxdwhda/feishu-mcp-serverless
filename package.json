    "ali-oss": "^6.23.0",
    "axios": "^1.20.0",
    "express": "^5.1.0",
    "zod": "^3.25.0",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@alicloud/fc20230330": "^4.8.2",
    "@alicloud/openapi-client": "^0.4.15",
    "@types/ali-oss": "^6.23.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
