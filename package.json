{
  "name": "feishu-mcp",
  "version": "0.3.0",
  "private": true,
  "description": "Feishu MCP with OAuth and durable storage for Alibaba Cloud FC",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "node scripts/build.mjs",
